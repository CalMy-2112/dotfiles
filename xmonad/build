#!/bin/sh
# xmonad runs this (from ~/.config/xmonad) instead of picking "ghc" from PATH.
# Uses Ubuntu's GHC, because the apt xmonad/xmonad-contrib libraries are only
# registered with it, not with ghcup's GHC (~/.ghcup/env is on PATH in zsh).
# $1 is the path xmonad wants the compiled binary at.
set -e
out="$1"
exec /usr/bin/ghc --make xmonad.hs -i -ilib -fforce-recomp -main-is main -v0 \
  -outputdir "$(dirname "$out")/build-$(uname -m)-linux" -o "$out"
