{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 6,
  "control-center-margin-bottom": 6,
  "control-center-margin-right": 6,
  "control-center-margin-left": 6,
  "control-center-width": 420,
  "control-center-height": 640,
  "fit-to-screen": false,
  "notification-window-width": 400,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No notifications",
  "widgets": [
    "buttons-grid",
    "backlight",
    "backlight#keyboard",
    "volume",
    "mpris",
    "dnd",
    "title",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "\uf1eb  Wi-Fi",
          "type": "toggle",
          "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then nmcli radio wifi on; else nmcli radio wifi off; fi'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "\uf293  Bluetooth",
          "type": "toggle",
          "command": "sh -c 'if [ \"$SWAYNC_TOGGLE_STATE\" = true ]; then rfkill unblock bluetooth; bluetoothctl power on; else bluetoothctl power off; fi'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "\uf186  Night Light",
          "type": "toggle",
          "command": "sh -c '\"$HOME/.local/bin/nightlight\" swaync'",
          "update-command": "sh -c '\"$HOME/.local/bin/nightlight\" status'"
        },
        {
          "label": "\uf0e8  Networks",
          "command": "sh -c 'swaync-client -cp; XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi || nm-connection-editor'"
        },
        {
          "label": "\uf294  Devices",
          "command": "sh -c 'swaync-client -cp; XDG_CURRENT_DESKTOP=GNOME gnome-control-center bluetooth || blueman-manager'"
        },
        {
          "label": "\uf028  Sound",
          "command": "sh -c 'swaync-client -cp; pavucontrol'"
        },
        {
          "label": "\uf023  Lock",
          "command": "sh -c 'swaync-client -cp; loginctl lock-session'"
        },
        {
          "label": "\uf013  Settings",
          "command": "sh -c 'swaync-client -cp; XDG_CURRENT_DESKTOP=GNOME gnome-control-center'"
        },
        {
          "label": "\uf011  Log Out",
          "command": "sh -c 'swaync-client -cp; \"$HOME/.config/hypr/scripts/exit-hyprland.sh\"'"
        }
      ]
    },
    "backlight": {
      "label": "\uf185",
      "device": "intel_backlight"
    },
    "backlight#keyboard": {
      "label": "\uf11c",
      "device": "kbd_backlight",
      "subsystem": "leds"
    },
    "volume": {
      "label": "\uf028"
    },
    "mpris": {
      "autohide": true
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    }
  }
}
