-- ~/.config/xmobar/xmobarrc: Qubes OS's i3bar layout in cccru colours.
--   left:  workspace buttons (only workspaces in use), click to switch,
--          scroll to move between them
--   right: status.sh (port of qubes-i3status), then the tray
-- Font: JetBrains Mono 10pt (regular, as Qubes' bar font is regular).
-- Height: i3bar's formula, font height (18px) + 3px above and below = 24.
-- If you change the height, also change trayer's --height in
-- xmonad/autostart.sh (height - 4, for i3's 2px tray padding).

Config
  { font             = "JetBrainsMono Nerd Font 10"
    -- fn=1: a space in this font is exactly 4px wide (0.6em of 6.667px).
    -- Used for i3's 4px padding inside workspace buttons, so the padding
    -- gets the button's fill colour.
  , additionalFonts  = [ "JetBrainsMono Nerd Font 6.667px" ]
  , bgColor          = "#0b0b0b"
  , fgColor          = "#e9efe9"
  , position         = TopH 24
  , textOffset       = -1                -- centre text vertically
  , lowerOnStart     = True
  , hideOnStart      = False
  , allDesktops      = True
  , persistent       = True
  , overrideRedirect = True
  , commands =
      [ Run XMonadLog
      , Run CommandReader "~/.config/xmobar/status.sh" "status"
      , Run Com "sh" ["-c", "~/.config/xmobar/trayer-padding.sh"] "trayerpad" 10
      ]
  , sepChar  = "%"
  , alignSep = "}{"
  -- <hspace=4/> before the tray: i3bar's gap between status text and tray.
  , template = "<action=`~/.config/xmobar/ws-scroll.sh prev` button=4><action=`~/.config/xmobar/ws-scroll.sh next` button=5>%XMonadLog%</action></action>}{%status%<hspace=4/>%trayerpad%"
  }
