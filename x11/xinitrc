#!/bin/sh
# ~/.xinitrc: run by "startx" from a text console (Ctrl+Alt+F3).
# GDM 50 on Ubuntu 26.04 can't start X11 sessions, so this is how xmonad starts.

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=xmonad
export XCURSOR_SIZE=36            # keep in step with Xcursor.size in ~/.Xresources
export XCURSOR_THEME=Yaru

# DPI, fonts and cursor (see ~/.Xresources)
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# Let the tray applets, notifications etc. find this display
dbus-update-activation-environment --systemd \
  DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XCURSOR_SIZE XCURSOR_THEME

exec xmonad
