{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // The gram (cccru). The colors are the terminal colors from
  // alacritty/cccru.toml: green #0bbf5b, cyan = mint #6fd495.
  // logo.txt starts with "$1", so all of the logo uses color 1.
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "green" }
  },
  "display": {
    "color": {
      "keys": "cyan",
      "title": "green"
    }
  },
  "modules": [
    "title", "separator", "os", "kernel", "uptime", "shell", "de", "wm",
    "font", "terminal", "terminalfont", "cpu", "memory", "gpu", "disk",
    "battery", "break", "colors"
  ]
}
