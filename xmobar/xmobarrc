-- ~/.config/xmobar/xmobarrc  (colours from cccru.ca: neon green on black)
-- Font: 12pt at Xft.dpi 96 (see x11/Xresources) = 16px. xmobar takes the
-- size in pixels so it doesn't depend on how it reads DPI.
-- If you change the font size or the bar height, also change the trayer
-- line in xmonad/autostart.sh (its --height and --distance).

Config
  { font             = "JetBrainsMono Nerd Font Bold 16px"
  , bgColor          = "#0b0b0b"
  , fgColor          = "#e9efe9"
  , border           = BottomB
  , borderColor      = "#2d732d"
  , position         = TopH 28
  , textOffset       = -1                -- centre text vertically
  , lowerOnStart     = True
  , hideOnStart      = False
  , allDesktops      = True
  , persistent       = True
  , overrideRedirect = True
  , commands =
      [ Run XMonadLog
      , Run Com      "sh" ["-c", "~/.config/xmobar/wifi.sh"] "wifi" 50
      , Run Cpu      [ "-t", "cpu <total>%"
                     , "-L", "30", "-H", "70"
                     , "--normal", "#6fd495", "--high", "#11ff7a" ] 20
      , Run Memory   [ "-t", "mem <usedratio>%"
                     , "-H", "80", "--high", "#11ff7a" ] 20
      , Run Battery  [ "-t", "<acstatus> <left>%"
                     , "-L", "20", "--low", "#afffd6"
                     , "--"
                     , "-O", "chg", "-i", "full", "-o", "bat"
                     ] 50
      , Run Date     "%a %d %b  %H:%M" "date" 100
      ]
  , sepChar  = "%"
  , alignSep = "}{"
  -- The single space before %XMonadLog% is counted in trayer's --distance.
  , template = " %XMonadLog% }{ <fc=#b7c9b7>%wifi%</fc>  <fc=#2d732d>|</fc>  <fc=#b7c9b7>%cpu%</fc>  <fc=#2d732d>|</fc>  <fc=#b7c9b7>%memory%</fc>  <fc=#2d732d>|</fc>  <fc=#b7c9b7>%battery%</fc>  <fc=#2d732d>|</fc>  <fc=#11ff7a>%date%</fc> "
  }
