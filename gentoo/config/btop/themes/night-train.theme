# btop theme: night-train (Gentoo, omen). Colors from wallpapers/hyprland-girl.jpg.
# install.sh sets color_theme = "night-train" in ~/.config/btop/btop.conf.
# It also sets theme_background = False, so the terminal blur shows through.

theme[main_bg]="#140b33"
theme[main_fg]="#e4e0f7"
theme[title]="#e4e0f7"
theme[hi_fg]="#47aeda"
theme[selected_bg]="#2b3786"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#6f6aa8"
theme[graph_text]="#aaa6d6"
theme[meter_bg]="#2a2160"
theme[proc_misc]="#7fd8f2"

theme[cpu_box]="#47aeda"
theme[mem_box]="#ba94c3"
theme[net_box]="#6f97e6"
theme[proc_box]="#e48ab8"
theme[div_line]="#3a3380"

theme[temp_start]="#47aeda"
theme[temp_mid]="#ba94c3"
theme[temp_end]="#f0647f"

theme[cpu_start]="#47aeda"
theme[cpu_mid]="#6f97e6"
theme[cpu_end]="#ba94c3"

theme[free_start]="#2b3786"
theme[free_mid]="#3765ba"
theme[free_end]="#47aeda"

theme[cached_start]="#3765ba"
theme[cached_mid]="#6f97e6"
theme[cached_end]="#7fd8f2"

theme[available_start]="#642c5f"
theme[available_mid]="#ba94c3"
theme[available_end]="#e48ab8"

theme[used_start]="#ba94c3"
theme[used_mid]="#e48ab8"
theme[used_end]="#f0647f"

theme[download_start]="#2b3786"
theme[download_mid]="#47aeda"
theme[download_end]="#7fd8f2"

theme[upload_start]="#642c5f"
theme[upload_mid]="#ba94c3"
theme[upload_end]="#e48ab8"

theme[process_start]="#47aeda"
theme[process_mid]="#ba94c3"
theme[process_end]="#f0647f"
