#!/bin/sh
# hxrun FILE -- compile and/or run FILE in a window that you can type into.
#
# In tmux:      a tmux popup (90% of the window).
# Not in tmux:  a new Alacritty window.
# The window stays open until you push Enter, so you can read the output.
#
# Helix calls this with F5 (see config.toml):
#   F5 = [":write", ":sh hxrun \"%{buffer_name}\""]
#
# Add a language: add one line to the "case" below.

if [ "$1" != --here ]; then
    # Step 1: open the window, and run this script again in it with --here.
    [ -f "$1" ] || { echo "hxrun: file not found: $1" >&2; exit 1; }
    file=$(realpath -- "$1")
    # F5 starts ":write" and this script at the same time, and the formatter
    # can make the save slow. So wait until the file was saved in the last
    # 2 seconds (maximum wait: 10 seconds).
    i=0
    while [ $(( $(date +%s) - $(stat -c %Y -- "$file") )) -gt 2 ] && [ $i -lt 100 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    dir=$(dirname -- "$file")
    self=$(command -v hxrun || echo "$0")
    if [ -n "$TMUX" ]; then
        tmux display-popup -E -w 90% -h 90% -d "$dir" -T " $(basename -- "$file") " \
            "$self" --here "$file"
    else
        setsid -f alacritty --working-directory "$dir" -e "$self" --here "$file" \
            >/dev/null 2>&1
    fi
    exit 0
fi

# Step 2: in the new window.
file=$2
cd "$(dirname -- "$file")" || exit 1
base=$(basename -- "$file")
name=${base%.*}
bin=${TMPDIR:-/tmp}/hxrun-$name   # compiled programs go here, not next to your code

printf '\033[2m$ %s\033[0m\n' "$base"
case $base in
    *.py)                  python3 "$base" ;;
    *.c)                   cc -Wall -g -o "$bin" "$base" -lm && "$bin" ;;
    *.cpp|*.cc|*.cxx)      c++ -Wall -g -o "$bin" "$base" && "$bin" ;;
    *.rs)                  if cargo locate-project >/dev/null 2>&1; then cargo run
                           else rustc -o "$bin" "$base" && "$bin"; fi ;;
    *.go)                  go run "$base" ;;
    *.java)                java "$base" ;;           # one-file programs (Java 11+)
    *.scala|*.sc)          scala-cli run "$base" ;;
    *.lua)                 lua "$base" ;;
    *.sh|*.bash)           bash "$base" ;;
    *.zsh)                 zsh "$base" ;;
    *.js|*.mjs)            node "$base" ;;
    *.ts)                  node "$base" ;;           # Node 23.6+ runs .ts files
    *.lisp|*.cl)           sbcl --script "$base" ;;
    *.hs)                  runghc "$base" ;;
    *)                     echo "hxrun: no rule for $base (add one in $0)"; false ;;
esac
status=$?
printf '\n\033[2m[exit %s] Push Enter to close.\033[0m' "$status"
read -r _
